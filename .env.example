# Copy this file to .env and fill in real values. All settings are read by
# backend/app/config.py (pydantic-settings) and are overridable as plain
# env vars at runtime (e.g. `docker run -e DEFAULT_CONCURRENCY=16 ...`)
# without rebuilding the image.

# DigitalOcean Serverless Inference API key. Get one from the DO control
# panel under GradientAI Platform > Serverless Inference > API Keys.
SI_API_KEY=

# Base URL for the OpenAI-compatible SI endpoint. Only change this if DO
# moves the endpoint.
SI_BASE_URL=https://inference.do-ai.run/v1

# How many issues are classified concurrently per model (asyncio.Semaphore
# bound). Higher = faster runs but more likely to hit per-model rate limits
# — see DESIGN_DECISIONS.md §3 for measured throughput ceilings per model.
DEFAULT_CONCURRENCY=8

# Per-request HTTP timeout, in seconds.
REQUEST_TIMEOUT_S=90.0

# Max retry attempts for rate-limit/5xx/timeout errors (exponential backoff).
# Non-retryable 4xx errors (bad request, bad model id) are never retried.
MAX_RETRIES=3

# Base delay, in seconds, for the exponential backoff between retries.
RETRY_BACKOFF_BASE_S=1.0

# Max output tokens per classification call. Sized generously (not the
# minimal ~5-10 tokens a bare label needs) because several candidate models
# are reasoning models that emit chain-of-thought before the final label —
# too low silently truncates them. See DESIGN_DECISIONS.md §4 and the
# 2026-09-10 screening-run findings for why this matters.
MAX_OUTPUT_TOKENS=1024

# When true, the inference client returns synthetic responses instead of
# calling the real SI API — no API key needed, no cost. Useful for demoing
# or developing the harness/UI without spending real credits.
DRY_RUN=false

# Where the corpus/ground-truth/run-result JSON files live. The Docker image
# sets this to /app/data automatically; only override for local dev if your
# data/ directory isn't at the repo root.
DATA_DIR=data

# HTTP Basic Auth credentials gating the whole app — leave both blank for
# local/Docker use (no auth wall). Only ever set on the hosted deployment, so
# a public URL in front of a real, billed SI key isn't reachable by anyone
# who finds the link. See backend/app/auth.py.
DEMO_USERNAME=
DEMO_PASSWORD=
